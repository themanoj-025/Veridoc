# ═══════════════════════════════════════════════════════════════════
# Veridoc – Production Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in all values.
#   cp .env.production.example .env
#
# Generate secrets:
#   python -c "import secrets; print(secrets.token_hex(32))"           # JWT_SECRET
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"  # FILE_ENCRYPTION_KEY
# ═══════════════════════════════════════════════════════════════════

# ── Security: REQUIRED (app will refuse to start without these) ──
JWT_SECRET=
FILE_ENCRYPTION_KEY=

# ── App ──
APP_ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.com
RATE_LIMIT_PER_MINUTE=30

# ── Postgres ──
POSTGRES_USER=veridoc
POSTGRES_PASSWORD=
POSTGRES_DB=veridoc
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── MinIO (S3-compatible storage) ──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=veridoc-documents
MINIO_USE_SSL=false

# ── ChromaDB ──
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=veridoc_documents

# ── LLM Provider (Ollama default, Claude/OpenAI optional) ──
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# ANTHROPIC_API_KEY=sk-ant-...   # Uncomment to use Claude
# OPENAI_API_KEY=sk-...          # Uncomment to use OpenAI

# ── Redis / Queue ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Optional OAuth (requires app registration) ──
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...

# ── Metrics (set to 1 to enable Prometheus /metrics endpoint) ──
# ENABLE_METRICS=1
