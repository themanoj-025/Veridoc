# ──────────────────────────────────────────────
# Veridoc — Environment Configuration
# Copy this to .env and fill in optional values.
# All defaults work for local-first usage with
# zero paid services or signups.
# ──────────────────────────────────────────────

# --- Postgres ---
POSTGRES_USER=veridoc
POSTGRES_PASSWORD=veridoc_local_dev
POSTGRES_DB=veridoc
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- MinIO (local S3-compatible storage) ---
MINIO_ROOT_USER=veridoc
MINIO_ROOT_PASSWORD=veridoc_minio_dev
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=veridoc-documents
MINIO_ACCESS_KEY=veridoc
MINIO_SECRET_KEY=veridoc_minio_dev
MINIO_USE_SSL=false

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- ChromaDB ---
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=veridoc_docs

# --- JWT ---
# ⚠️ REQUIRED: Generate a strong secret. The app WILL FAIL TO START without it.
# Run: python -c "import secrets; print(secrets.token_hex(32))"
# Paste the output as JWT_SECRET below (no quotes).
JWT_SECRET=change-me-to-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Encryption (at rest) ---
# ⚠️ REQUIRED: Generate a Fernet-compatible key. The app WILL FAIL TO START without it.
# Run: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Paste the output as FILE_ENCRYPTION_KEY below (no quotes).
FILE_ENCRYPTION_KEY=change-me-to-a-real-key

# --- LLM (default: local via Ollama) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# --- Optional: Claude API (overrides Ollama if set) ---
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=claude

# --- Optional: OpenAI API ---
# OPENAI_API_KEY=sk-...
# LLM_PROVIDER=openai

# --- Optional: Google/GitHub OAuth (requires app registration) ---
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=30
